# systemd user-Unit fuer den gunicorn-Prozess des OpenMycoNet-Backends.
#
# Installation (als User omn):   bash /home/omn/app/deploy/install_systemd.sh
# Einmalig als root noetig:       loginctl enable-linger omn
#   (sonst laeuft die Unit nur solange eine Login-Session von omn offen ist)
#
# Bedienung:
#   systemctl --user status omn
#   systemctl --user reload omn      # sanftes HUP (Worker neu, kein Downtime)
#   systemctl --user restart omn
#   journalctl --user -u omn -f
#
# ExecStart zeigt seit Phase 2 des Factory-Umbaus auf wsgi:app (create_app()).
# -k gthread --threads 4: IO-lastige Requests (SMTP, Anthropic-API, Feed-Abruf)
# blockieren nicht mehr den ganzen Prozess -- bei IO gibt Python den GIL frei.
# Aendert sich diese Zeile -> nach dem Deploy `bash deploy/install_systemd.sh`.

[Unit]
Description=OpenMycoNet gunicorn (Flask backend)
After=network.target

[Service]
WorkingDirectory=/home/omn/app
ExecStart=/home/omn/app/venv/bin/gunicorn -w 2 -k gthread --threads 4 --timeout 60 -b 127.0.0.1:5000 wsgi:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=10
# --- Haertung (seit 23.10.2026, Sicherheitsdurchsicht Paket 2) ---
# Nur Optionen, die in einer USER-Unit ohne User-Namespaces greifen (seccomp/
# prctl). ProtectSystem=, PrivateTmp=, ProtectHome= usw. brauchen in User-Units
# einen User-Namespace -- den sperrt Ubuntu 26.04 per AppArmor
# (kernel.apparmor_restrict_unprivileged_userns=1), die Unit startete dann nicht
# (Status 226/NAMESPACE). Dafuer muesste omn eine System-Unit mit User=omn werden.
# Gilt auch fuer die Backup-Skripte, die der MCC-Knopf startet (bash, pg_dump,
# gzip, curl: keine setuid-Programme, nur Unix-/IP-Sockets).
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
