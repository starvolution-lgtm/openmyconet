# Vorlage fuer /home/omn/app-staging/.env  --  NICHT ins Git, echte Werte auf dem Server.
# Anlegen:  nano /home/omn/app-staging/.env   (Werte eintragen, dann chmod 600)

# Eigener Key, NICHT der Prod-Key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=BITTE-EIGENEN-ERZEUGEN

# Umgebungs-Kennung -> roter Banner im Admin + Header X-OMN-Env
OMN_ENV=staging

# Staging verschickt NIE echte Mails (Rundmail-Tests landen nur im Journal)
MAIL_SUPPRESS_SEND=True

# Mail-Zugang darf leer/Dummy sein, solange MAIL_SUPPRESS_SEND=True
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=staging@openmyconet.de

# Admin-Benachrichtigungen (foerderer/kollaboration) -- Dummy reicht
ADMIN_NOTIFY_EMAIL=staging@openmyconet.de

# PayPal: Sandbox oder leer (kein echter Zahlungsverkehr auf Staging)
PAYPAL_EMAIL=

# Kein Offsite-Backup fuer Staging noetig (BACKUP_FTP_* weglassen)
