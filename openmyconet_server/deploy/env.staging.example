# Vorlage fuer /home/omn/app-staging/.env  --  NICHT ins Git, echte Werte auf dem Server.
# Anlegen:  nano /home/omn/app-staging/.env   (Werte eintragen, dann chmod 600)

# Eigener Key, NICHT der Prod-Key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=BITTE-EIGENEN-ERZEUGEN

# Umgebungs-Kennung -> roter Banner im Admin + Header X-OMN-Env
OMN_ENV=staging

# Staging verschickt NIE echte Mails (Rundmail-Tests landen nur im Journal)
MAIL_SUPPRESS_SEND=True

# Mail-Zugang darf leer/Dummy sein, solange MAIL_SUPPRESS_SEND=True
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=staging@openmyconet.de

# Admin-Benachrichtigungen (foerderer/kollaboration) -- Dummy reicht
ADMIN_NOTIFY_EMAIL=staging@openmyconet.de

# Server-MCC (/mcc): Vorstellungs-Mails ueber das Postfach robert.jank@. Auf Staging
# wegen MAIL_SUPPRESS_SEND nie verschickt -- leer lassen reicht. Prod (.env):
#   MCC_MAIL_USERNAME=<Login des Postfachs robert.jank@ aus dem KAS>
#   MCC_MAIL_PASSWORD=<Passwort dieses Postfachs>
#   MCC_MAIL_SENDER=robert.jank@openmyconet.de
#   MCC_MAIL_BCC=robert.jank@openmyconet.de
#   (optional) MCC_ERINNERUNG_AN, MCC_MAIL_SENDER_NAME, MCC_WIEDERVORLAGE_TAGE=14, MCC_NACHFRAGE_TAGE=7

# PayPal: Sandbox oder leer (kein echter Zahlungsverkehr auf Staging)
PAYPAL_EMAIL=

# Datenbank: ohne DATABASE_URL laeuft die App auf der lokalen SQLite-Datei
# (instance/openmyconet.db). Fuer den spaeteren Postgres-Cutover (Schritt 3):
#   DATABASE_URL=postgresql+psycopg://omn:PASSWORT@127.0.0.1:5432/omn_staging
# postgres:// bzw. postgresql:// werden automatisch auf den psycopg3-Treiber gezwungen.

# Kein Offsite-Backup fuer Staging noetig (BACKUP_FTP_* weglassen)
