{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": [
        "http://127.0.0.1:5000/",
        "http://127.0.0.1:5000/biocomm",
        "http://127.0.0.1:5000/biocomm/hardware",
        "http://127.0.0.1:5000/biocomm/software",
        "http://127.0.0.1:5000/presse",
        "http://127.0.0.1:5000/medien.html",
        "http://127.0.0.1:5000/foerderer.html",
        "http://127.0.0.1:5000/leihgeraete.html",
        "http://127.0.0.1:5000/mykorrhiza-netzwerke.html",
        "http://127.0.0.1:5000/bioelektrizitaet-biocomm.html",
        "http://127.0.0.1:5000/citizen-science-openmyconet.html",
        "http://127.0.0.1:5000/wie-wir-arbeiten",
        "http://127.0.0.1:5000/quellennachweise.html",
        "http://127.0.0.1:5000/news",
        "http://127.0.0.1:5000/impressum.html",
        "http://127.0.0.1:5000/datenschutz.html"
      ],
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "chromeFlags": "--no-sandbox --headless=new",
        "formFactor": "desktop",
        "screenEmulation": { "mobile": false, "width": 1350, "height": 940, "deviceScaleFactor": 1, "disabled": false }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.98 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-report"
    }
  }
}
