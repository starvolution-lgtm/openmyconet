# Shell-Skripte im deploy/-Ordner laufen auf dem Linux-Server -> immer LF,
# sonst brechen sie mit "\r command not found" ab, wenn Git sie auf Windows
# mit CRLF auscheckt.
deploy/*.sh text eol=lf
*.sh text eol=lf
# deploy-exclude.txt wird von rsync --exclude-from gelesen -> CRLF wuerde \r in die
# Patterns bringen und den Schutz (instance/, .env, uploads ...) aushebeln.
deploy/deploy-exclude.txt text eol=lf
