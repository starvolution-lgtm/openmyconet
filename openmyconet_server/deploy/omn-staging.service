# systemd user-Unit fuer die STAGING-Instanz des OpenMycoNet-Backends.
#
# Zweiter gunicorn auf Port 5001, eigenes Verzeichnis /home/omn/app-staging,
# eigene DB, eigene .env (mit OMN_ENV=staging + MAIL_SUPPRESS_SEND=True).
#
# Installation (als User omn):  bash /home/omn/app/deploy/install_systemd_staging.sh
# linger deckt beide Units ab (gleicher User omn).
#
# Bedienung:
#   systemctl --user status omn-staging
#   systemctl --user restart omn-staging
#   journalctl --user -u omn-staging -f

[Unit]
Description=OpenMycoNet gunicorn (STAGING)
After=network.target

[Service]
WorkingDirectory=/home/omn/app-staging
ExecStart=/home/omn/app-staging/venv/bin/gunicorn -w 1 -k gthread --threads 4 --timeout 60 -b 127.0.0.1:5001 wsgi:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=10
# --- Haertung (seit 23.10.2026, Sicherheitsdurchsicht Paket 2) ---
# Nur Optionen, die in einer USER-Unit ohne User-Namespaces greifen (seccomp/
# prctl). ProtectSystem=, PrivateTmp=, ProtectHome= usw. brauchen in User-Units
# einen User-Namespace -- den sperrt Ubuntu 26.04 per AppArmor
# (kernel.apparmor_restrict_unprivileged_userns=1), die Unit startete dann nicht
# (Status 226/NAMESPACE). Dafuer muesste omn eine System-Unit mit User=omn werden.
# Gilt auch fuer die Backup-Skripte, die der MCC-Knopf startet (bash, pg_dump,
# gzip, curl: keine setuid-Programme, nur Unix-/IP-Sockets).
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
