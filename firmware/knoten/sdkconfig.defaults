# Voreinstellungen fuer den Kombi-Node (ESP32-S3). sdkconfig selbst wird beim Bauen
# erzeugt und nicht eingecheckt.
CONFIG_IDF_TARGET="esp32s3"
# Ed25519 + SHA-256 brauchen etwas Stapel; Puffer liegen ohnehin statisch.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# 1-ms-Takt für die Wartezeiten der Messung
CONFIG_FREERTOS_HZ=1000
# Lange Dateinamen: Laufordner wie "b17-3fa91c07" passen nicht in 8.3
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
# GPIO-Funktionen im IRAM (Bereitmeldung alle 4 ms, auch während Flash-Zugriffen)
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
